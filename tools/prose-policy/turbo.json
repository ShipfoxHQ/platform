{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "verify": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.vale.ini",
        "$TURBO_ROOT$/mise.toml",
        "$TURBO_ROOT$/tools/prose-policy/styles/**/*.yml",
        "$TURBO_ROOT$/tools/prose-policy/styles/**/*.{json,txt}",
        "$TURBO_ROOT$/{AGENTS.md,DESIGN.md,README.md,WRITING.md}",
        "$TURBO_ROOT$/apps/docs/content/**/*.{md,mdx}",
        "$TURBO_ROOT$/docs/**/*.md",
        "$TURBO_ROOT$/**/README.md",
        "$TURBO_ROOT$/.changeset/**/*.md"
      ]
    }
  }
}
