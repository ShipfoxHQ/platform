[Unit]
Description=Validate Shipfox runner environment file
After=network-online.target shipfox-bootstrap.service
Wants=network-online.target shipfox-runner.target

[Service]
Type=oneshot
StandardOutput=journal+console
ExecStartPre=/bin/sh -c '/usr/bin/timeout 5s /opt/shipfox-runner/scripts/runtime/record-boot-io.sh || true'
ExecStart=/usr/bin/test -s /etc/shipfox/runner.env
RemainAfterExit=yes
