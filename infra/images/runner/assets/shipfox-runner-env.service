[Unit]
Description=Validate Shipfox runner environment file
After=network-online.target
Wants=network-online.target shipfox-runner.target

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c '/opt/shipfox-runner/scripts/runtime/record-boot-io.sh || true'
ExecStart=/usr/bin/test -s /etc/shipfox/runner.env
RemainAfterExit=yes
