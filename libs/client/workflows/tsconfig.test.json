{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    // The shared storybook helper is intentionally part of this type program:
    // it is the single source of truth for the workspace-source vite config, so
    // rootDir spans the shared .storybook directory (noEmit anyway).
    "rootDir": "../..",
    "noEmit": true
  },
  "include": [
    "src",
    "test",
    "../.storybook/workspace-source.ts",
    "vitest.config.ts",
    "node_modules/@shipfox/vitest/globals.d.ts"
  ],
  "exclude": ["**/*.stories.tsx"]
}
